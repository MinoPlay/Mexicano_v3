{
  "name": "mexicano-tournament-manager",
  "version": "1.0.0",
  "description": "Mexicano padel/tennis tournament manager PWA",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate:datahub:supabase": "node scripts/supabase/import-datahub.mjs",
    "backup:supabase:github": "node scripts/supabase/export-to-github.mjs",
    "auth:user:supabase": "node scripts/supabase/manage-auth-user.mjs",
    "test:unit": "vitest run",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.50.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "serve": "^14.2.0",
    "vitest": "^4.1.5"
  }
}
